# OpenAI API key — required for the chatbot feature.
# Set this in your Netlify dashboard under Site Settings > Environment Variables.
# Never commit a real key; .env is gitignored.
OPENAI_API_KEY=your-openai-api-key-here

# Feedback form endpoint — required for the /contribute form.
# Use a Formspree endpoint (https://formspree.io) or any JSON-accepting POST URL.
VITE_FEEDBACK_ENDPOINT=https://formspree.io/f/your-form-id
